# Copy this file to .env and fill in real values.

# Leave as-is for zero-setup local dev (SQLite file in this folder).
# To use Postgres instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/career_os
DATABASE_URL=your_database_url_here

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

CHROMA_PERSIST_DIR=./chroma_data
APP_ENV=dev

# Comma-separated Greenhouse board tokens for companies you're targeting.
# Find a company's token in their job board URL: boards.greenhouse.io/<token>
# e.g. TARGET_COMPANIES=stripe,notion,airbnb
TARGET_COMPANIES=target_companies-separated-by-commas_here
